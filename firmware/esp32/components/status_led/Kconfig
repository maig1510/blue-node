menu "Status LED"

    choice STATUS_LED_TYPE
        prompt "LED type"
        default STATUS_LED_TYPE_WS2812
        help
            What the status LED is. The ESP32-C6-DevKit carries one WS2812 RGB
            LED on GPIO8. A plain LED on a GPIO shows the same patterns as
            blink rhythms only, without colour.

        config STATUS_LED_TYPE_WS2812
            bool "WS2812 addressable RGB LED"
        config STATUS_LED_TYPE_GPIO
            bool "Plain LED on a GPIO"
        config STATUS_LED_TYPE_NONE
            bool "No LED"
    endchoice

    config STATUS_LED_GPIO
        int "LED GPIO"
        depends on !STATUS_LED_TYPE_NONE
        default 8
        range 0 30
        help
            GPIO8 is a strapping pin on the ESP32-C6. The DevKit's WS2812 sits
            on it and is fine there; on a custom board prefer a GPIO that is
            not a strapping pin (4, 5, 8, 9 and 15 are).

    config STATUS_LED_GPIO_ACTIVE_HIGH
        bool "GPIO LED is lit when the pin is high"
        depends on STATUS_LED_TYPE_GPIO
        default y

    config STATUS_LED_BRIGHTNESS
        int "WS2812 brightness (0-255)"
        depends on STATUS_LED_TYPE_WS2812
        default 32
        range 1 255
        help
            Full brightness on a bare WS2812 is uncomfortable to look at and
            costs ~50 mA; status only needs to be visible.

endmenu
