# Repo-wide rules only.
# Subproject-specific rules live next to the code they describe:
#   firmware/.gitignore  - ESP-IDF
#   backend/.gitignore   - Python
#   hardware/.gitignore  - KiCad
#   app/.gitignore       - Flutter (stock template, regenerated by `flutter create`)

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Directory metadata
.directory

# Temporary files
*~
*.swp
*.swo
*.bak
*.tmp

# Log files
*.log

# Database files
*.db

# Build artifacts and directories
**/build/
build/
*.o
*.a
*.out
# For any host-side utilities compiled on Windows
*.exe

# Windows specific
Thumbs.db
ehthumbs.db
Desktop.ini

# User-specific configuration files
*.user
# General workspace files, can be from various tools
*.workspace
# Visual Studio Solution User Options
*.suo
# Visual Studio
*.sln.docstates

# Editors
# .vscode/ holds machine-specific absolute toolchain paths in this repo
.vscode/
.idea/
*.iml
# VSCode Local History extension
.history/

# Vendor datasheets - large and re-downloadable
docs/datasheets/
